# Normalize line endings to LF in the repo, checkout as-is on Windows
* text=auto eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.mjs text eol=lf

# Binaries
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.pdf  binary
